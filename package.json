{
  "name": "bb-plugin-runnable-blocks",
  "version": "0.2.0",
  "type": "module",
  "description": "A Run button on shell code blocks in bb agent replies: runs the command in the thread's side-panel terminal, with a confirmation step and risky-command warnings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasherjoshuachan/bb-plugin-runnable-blocks.git"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "terminal",
    "code-blocks",
    "shell"
  ],
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Runnable Blocks",
    "description": "Run, or insert, shell code blocks from agent replies in the thread's terminal. Never runs anything without a click; multi-line and risky commands ask first.",
    "branding": {
      "icon": "Play"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
